# Скопируй этот файл в .env и подставь свои значения.
# .env в git не попадает.

DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# База данных: sqlite (по умолчанию) или postgres
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=bookstore
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Через запятую, без пробелов
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Отдача файлов книг.
# Пусто — файл шлёт сам Django (нормально для разработки).
# В проде переложи на веб-сервер, чтобы не занимать процесс Django на всё время
# скачивания. Для nginx: PROTECTED_MEDIA_ACCEL_HEADER=X-Accel-Redirect,
# а в конфиге nginx завести internal-локацию, указывающую на protected_media/.
PROTECTED_MEDIA_ACCEL_HEADER=
PROTECTED_MEDIA_INTERNAL_URL=/protected/

# Пока True — книги выдаются бесплатно, оплата пропускается.
# Переключить в False, когда будет подключён Stripe.
PURCHASES_ARE_FREE=True
